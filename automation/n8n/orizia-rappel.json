        "jsCode": "const p = $input.first().json.body;\nif (!p || typeof p !== 'object' || Array.isArray(p)) throw new Error('Corps JSON invalide');\nfor (const key of ['numero_dossier', 'profil_nom', 'profil_prenom', 'profil_mail', 'profil_tel']) {\n  if (typeof p[key] !== 'string' || !p[key].trim() || p[key].length > 300) throw new Error('Champ invalide : ' + key);\n}\nif (!/^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/.test(p.profil_mail)) throw new Error('Email invalide');\nconst escape = value => String(value).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst v = (key, escaped) => typeof p[key] === 'string' && escaped ? escape(p[key]) : (p[key] ?? '');\nconst select = (value, ...args) => {\n  for (let i = 0; i + 1 < args.length; i += 2) if (value === args[i]) return args[i + 1];\n  return args.length % 2 ? args[args.length - 1] : '';\n};\nconst fields = [\"numero_dossier\", \"date_creation\", \"profil_prenom\", \"profil_nom\", \"profil_tel\", \"profil_codetel\", \"profil_mail\", \"profil_ville\", \"action\"];\nconst document = Object.fromEntries(fields.map(k => [k, p[k] ?? null]));\nconst html0 = \"<!DOCTYPE html>\\r\\n<html lang=\\\"fr\\\">\\r\\n<head>\\r\\n  <meta charset=\\\"UTF-8\\\">\\r\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\r\\n  <title>🔔 Demande de rappel — Orizia Courtage</title>\\r\\n</head>\\r\\n<body style=\\\"margin:0;padding:0;background-color:#f0f2f7;font-family:'Segoe UI',Arial,sans-serif;\\\">\\r\\n\\r\\n  <!-- Wrapper -->\\r\\n  <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"background:#f0f2f7;padding:32px 16px;\\\">\\r\\n    <tr>\\r\\n      <td align=\\\"center\\\">\\r\\n        <table width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"max-width:600px;width:100%;\\\">\\r\\n\\r\\n          <!-- ═══ HEADER ═══ -->\\r\\n          <tr>\\r\\n            <td style=\\\"background:linear-gradient(135deg,#0d2c54 0%,#1a4278 100%);border-radius:16px 16px 0 0;padding:36px 40px 28px;text-align:center;\\\">\\r\\n              <!-- Logo / Brand -->\\r\\n              <div style=\\\"margin-bottom:20px;\\\">\\r\\n                <span style=\\\"display:inline-block;background:rgba(240,165,0,0.15);border:1px solid rgba(240,165,0,0.4);border-radius:100px;padding:6px 18px;font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#f0a500;\\\">\\r\\n                  ✦ Orizia Courtage\\r\\n                </span>\\r\\n              </div>\\r\\n              <!-- Alert icon -->\\r\\n              <div style=\\\"width:64px;height:64px;background:linear-gradient(135deg,#f0a500,#ff8c00);border-radius:50%;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 24px rgba(240,165,0,0.45);\\\">\\r\\n                <span style=\\\"font-size:28px;line-height:64px;display:block;text-align:center;\\\">📞</span>\\r\\n              </div>\\r\\n              <h1 style=\\\"margin:0 0 8px;font-size:22px;font-weight:700;color:#ffffff;font-family:Georgia,serif;letter-spacing:-0.01em;\\\">\\r\\n                Nouvelle demande de rappel\\r\\n              </h1>\\r\\n              <p style=\\\"margin:0;font-size:14px;color:rgba(255,255,255,0.65);font-weight:400;\\\">\\r\\n                Un client souhaite être rappelé — à traiter en priorité\\r\\n              </p>\\r\\n            </td>\\r\\n          </tr>\\r\\n\\r\\n          <!-- ═══ URGENCY BANNER ═══ -->\\r\\n          <tr>\\r\\n            <td style=\\\"background:#f0a500;padding:12px 40px;text-align:center;\\\">\\r\\n              <p style=\\\"margin:0;font-size:13px;font-weight:700;color:#fff;letter-spacing:0.04em;text-transform:uppercase;\\\">\\r\\n                ⚡ Action requise — Rappeler ce prospect dès que possible\\r\\n              </p>\\r\\n            </td>\\r\\n          </tr>\\r\\n\\r\\n          <!-- ═══ BODY ═══ -->\\r\\n          <tr>\\r\\n            <td style=\\\"background:#ffffff;padding:36px 40px;\\\">\\r\\n\\r\\n              <!-- Intro -->\\r\\n              <p style=\\\"margin:0 0 28px;font-size:15px;color:#4a5568;line-height:1.6;\\\">\\r\\n                Bonjour,<br><br>\\r\\n                Le prospect ci-dessous a complété son formulaire de simulation de regroupement de crédits et a demandé à être <strong style=\\\"color:#0d2c54;\\\">rappelé(e) par téléphone</strong>. Voici toutes les informations nécessaires pour le contacter.\\r\\n              </p>\\r\\n\\r\\n              <!-- ─── Contact Card ─── -->\\r\\n              <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"background:#f8faff;border:2px solid #0d2c54;border-radius:12px;margin-bottom:28px;overflow:hidden;\\\">\\r\\n                <tr>\\r\\n                  <td style=\\\"background:#0d2c54;padding:12px 20px;\\\">\\r\\n                    <p style=\\\"margin:0;font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#f0a500;\\\">Contact à rappeler</p>\\r\\n                  </td>\\r\\n                </tr>\\r\\n                <tr>\\r\\n                  <td style=\\\"padding:24px 20px;\\\">\\r\\n                    <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\r\\n\\r\\n                      <!-- Nom complet -->\\r\\n                      <tr>\\r\\n                        <td style=\\\"padding:10px 0;border-bottom:1px solid #e8edf5;\\\">\\r\\n                          <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\r\\n                            <tr>\\r\\n                              <td width=\\\"36\\\" style=\\\"vertical-align:middle;\\\">\\r\\n                                <div style=\\\"width:32px;height:32px;background:#e8f0ff;border-radius:8px;text-align:center;line-height:32px;font-size:15px;\\\">👤</div>\\r\\n                              </td>\\r\\n                              <td style=\\\"padding-left:12px;vertical-align:middle;\\\">\\r\\n                                <span style=\\\"display:block;font-size:11px;color:#8896ab;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:2px;\\\">Nom complet</span>\\r\\n                                <span style=\\\"font-size:16px;font-weight:700;color:#0d2c54;\\\">\" + String(v(\"profil_prenom\", true)) + \" \" + String(v(\"profil_nom\", true)) + \"</span>\\r\\n                              </td>\\r\\n                            </tr>\\r\\n                          </table>\\r\\n                        </td>\\r\\n                      </tr>\\r\\n\\r\\n                      <!-- Téléphone -->\\r\\n                      <tr>\\r\\n                        <td style=\\\"padding:10px 0;border-bottom:1px solid #e8edf5;\\\">\\r\\n                          <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\r\\n                            <tr>\\r\\n                              <td width=\\\"36\\\" style=\\\"vertical-align:middle;\\\">\\r\\n                                <div style=\\\"width:32px;height:32px;background:#fff4e0;border-radius:8px;text-align:center;line-height:32px;font-size:15px;\\\">📱</div>\\r\\n                              </td>\\r\\n                              <td style=\\\"padding-left:12px;vertical-align:middle;\\\">\\r\\n                                <span style=\\\"display:block;font-size:11px;color:#8896ab;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:2px;\\\">Téléphone</span>\\r\\n                                <a href=\\\"tel:\" + String(v(\"profil_codetel\", true)) + String(v(\"profil_tel\", true)) + \"\\\" style=\\\"font-size:20px;font-weight:800;color:#f0a500;text-decoration:none;letter-spacing:0.02em;\\\">\" + String(v(\"profil_codetel\", true)) + \" \" + String(v(\"profil_tel\", true)) + \"</a>\\r\\n                              </td>\\r\\n                            </tr>\\r\\n                          </table>\\r\\n                        </td>\\r\\n                      </tr>\\r\\n\\r\\n                      <!-- Email -->\\r\\n                      <tr>\\r\\n                        <td style=\\\"padding:10px 0;border-bottom:1px solid #e8edf5;\\\">\\r\\n                          <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\r\\n                            <tr>\\r\\n                              <td width=\\\"36\\\" style=\\\"vertical-align:middle;\\\">\\r\\n                                <div style=\\\"width:32px;height:32px;background:#e8f8f0;border-radius:8px;text-align:center;line-height:32px;font-size:15px;\\\">✉️</div>\\r\\n                              </td>\\r\\n                              <td style=\\\"padding-left:12px;vertical-align:middle;\\\">\\r\\n                                <span style=\\\"display:block;font-size:11px;color:#8896ab;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:2px;\\\">Email</span>\\r\\n                                <a href=\\\"mailto:\" + String(v(\"profil_mail\", true)) + \"\\\" style=\\\"font-size:14px;font-weight:600;color:#2b8cff;text-decoration:none;\\\">\" + String(v(\"profil_mail\", true)) + \"</a>\\r\\n                              </td>\\r\\n                            </tr>\\r\\n                          </table>\\r\\n                        </td>\\r\\n                      </tr>\\r\\n\\r\\n                      <!-- Ville -->\\r\\n                      <tr>\\r\\n                        <td style=\\\"padding:10px 0;border-bottom:1px solid #e8edf5;\\\">\\r\\n                          <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\r\\n                            <tr>\\r\\n                              <td width=\\\"36\\\" style=\\\"vertical-align:middle;\\\">\\r\\n                                <div style=\\\"width:32px;height:32px;background:#f0e8ff;border-radius:8px;text-align:center;line-height:32px;font-size:15px;\\\">📍</div>\\r\\n                              </td>\\r\\n                              <td style=\\\"padding-left:12px;vertical-align:middle;\\\">\\r\\n                                <span style=\\\"display:block;font-size:11px;color:#8896ab;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:2px;\\\">Ville</span>\\r\\n                                <span style=\\\"font-size:14px;font-weight:600;color:#0d2c54;\\\">\" + String(v(\"profil_ville\", true)) + \"</span>\\r\\n                              </td>\\r\\n                            </tr>\\r\\n                          </table>\\r\\n                        </td>\\r\\n                      </tr>\\r\\n\\r\\n                      <!-- N° Dossier -->\\r\\n                      <tr>\\r\\n                        <td style=\\\"padding:10px 0;\\\">\\r\\n                          <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\r\\n                            <tr>\\r\\n                              <td width=\\\"36\\\" style=\\\"vertical-align:middle;\\\">\\r\\n                                <div style=\\\"width:32px;height:32px;background:#fff0f0;border-radius:8px;text-align:center;line-height:32px;font-size:15px;\\\">🗂️</div>\\r\\n                              </td>\\r\\n                              <td style=\\\"padding-left:12px;vertical-align:middle;\\\">\\r\\n                                <span style=\\\"display:block;font-size:11px;color:#8896ab;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:2px;\\\">N° Dossier</span>\\r\\n                                <span style=\\\"font-size:14px;font-weight:700;color:#0d2c54;font-family:monospace;background:#f0f2f7;padding:2px 8px;border-radius:4px;\\\">\" + String(v(\"numero_dossier\", true)) + \"</span>\\r\\n                              </td>\\r\\n                            </tr>\\r\\n                          </table>\\r\\n                        </td>\\r\\n                      </tr>\\r\\n\\r\\n                    </table>\\r\\n                  </td>\\r\\n                </tr>\\r\\n              </table>\\r\\n\\r\\n              <!-- ─── CTA Appel ─── -->\\r\\n              <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"margin-bottom:28px;\\\">\\r\\n                <tr>\\r\\n                  <td align=\\\"center\\\">\\r\\n                    <a href=\\\"tel:\" + String(v(\"profil_codetel\", true)) + String(v(\"profil_tel\", true)) + \"\\\"\\r\\n                       style=\\\"display:inline-block;background:linear-gradient(135deg,#f0a500 0%,#ff8c00 100%);color:#ffffff;font-size:16px;font-weight:700;text-decoration:none;padding:16px 40px;border-radius:10px;box-shadow:0 4px 16px rgba(240,165,0,0.4);letter-spacing:0.02em;\\\">\\r\\n                      📞 &nbsp;Appeler maintenant\\r\\n                    </a>\\r\\n                  </td>\\r\\n                </tr>\\r\\n              </table>\\r\\n\\r\\n              <!-- ─── Tip ─── -->\\r\\n              <table width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"background:#f0f7ff;border-left:4px solid #2b8cff;border-radius:0 8px 8px 0;margin-bottom:8px;\\\">\\r\\n                <tr>\\r\\n                  <td style=\\\"padding:14px 18px;\\\">\\r\\n                    <p style=\\\"margin:0;font-size:13px;color:#2d4a7a;line-height:1.6;\\\">\\r\\n                      <strong>💡 Rappel :</strong> Ce prospect a déjà rempli l'intégralité de son dossier. Toutes les informations financières sont disponibles dans un mail envoyé par dossier@orizia-courtage.fr sous le n° <strong>\" + String(v(\"numero_dossier\", true)) + \"</strong>. Pensez à consulter le dossier avant d'appeler pour personnaliser votre approche.\\r\\n                    </p>\\r\\n                  </td>\\r\\n                </tr>\\r\\n              </table>\\r\\n\\r\\n            </td>\\r\\n          </tr>\\r\\n\\r\\n          <!-- ═══ FOOTER ═══ -->\\r\\n          <tr>\\r\\n            <td style=\\\"background:#f8faff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 16px 16px;padding:20px 40px;text-align:center;\\\">\\r\\n              <p style=\\\"margin:0 0 4px;font-size:12px;color:#8896ab;\\\">\\r\\n                Cet email est généré automatiquement par le formulaire de simulation — <strong style=\\\"color:#0d2c54;\\\">Orizia Courtage</strong>\\r\\n              </p>\\r\\n              <p style=\\\"margin:0;font-size:11px;color:#b0bdd0;\\\">\\r\\n                \" + String(v(\"date_creation\", true)) + \" · Demande de rappel · \" + String(v(\"numero_dossier\", true)) + \"              </p>\\r\\n            </td>\\r\\n          </tr>\\r\\n\\r\\n        </table>\\r\\n      </td>\\r\\n    </tr>\\r\\n  </table>\\r\\n\\r\\n</body>\\r\\n</html>\";\nreturn [{json: {...document, html0}}];"
